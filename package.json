{
  "name": "drea",
  "version": "4.0.4",
  "description": "A RuleForge validation system for JavaScript and Typescript.",
  "keywords": [
    "validation",
    "schema",
    "RuleForge",
    "forms",
    "normalizer",
    "schema composition"
  ],
  "homepage": "https://github.com/blessBfon/drea#readme",
  "bugs": {
    "url": "https://github.com/blessBfon/drea/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blessBfon/drea.git"
  },
  "license": "MIT",
  "author": "Bless B.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "imports": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --verbose",
    "build": "vite build",
    "dev": "tsup src/index.ts --watch --dts --format esm",
    "build:watch": "tsc -w",
    "prepublishOnly": "npm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^5.0.3",
    "vitepress": "^1.6.4"
  },
  "sideEffects": false
}
