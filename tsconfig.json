{
    "compilerOptions":{
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "outDir": "dist",
        "rootDir": "src",
        "declaration": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "declarationMap": true,
        "types":["jest","node"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["dist", "node_modules", "**/dist"]
}